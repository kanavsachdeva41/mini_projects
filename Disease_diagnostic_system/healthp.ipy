advice_dict = {
    "COVID-19": "Isolate, drink fluids, monitor oxygen, consult doctor",
    "Chickenpox": "Avoid scratching, maintain hygiene, isolate",
    "Malaria": "Take medicines, avoid mosquitoes, rest",
    "Flu": "Rest, fluids, paracetamol",
    "Dengue": "Drink fluids, monitor platelets, see doctor",
    "Food Poisoning": "ORS, light food, hydration",
    "Sinusitis": "Steam inhalation, warm compress",
    "Common Cold": "Rest, warm fluids, steam",
    "Migraine": "Avoid stress, dark room rest",
    "Typhoid": "Antibiotics, clean water, hygiene"
}

# new diagnose - checks all the match symptoms and accordingly gives the disease output

def diagnose():
    symptoms = [s.strip().lower() for s in esym.get().split(",")]

    best_match = None
    max_match = 0

    for index, row in df.iterrows():
        disease = row['Disease']
        dsym = [s.strip().lower() for s in str(row['Symptoms_List']).split(",")]

        # count matching symptoms
        match_count = len(set(symptoms).intersection(set(dsym)))

        if match_count > max_match:
            max_match = match_count
            best_match = disease

    if best_match and max_match > 0:
        lresult.config(text=f"Possible disease: {best_match}\n\nAdvice: {advice_dict.get(best_match,'No advice')}")
    else:
        lresult.config(text="No disease found")

        # Creation of a database to store patient detials

    connec = sq.connect("Health.db") ## helps in connecting the database
    cursor = connec.cursor()

    # Creation of table 

    cursor.execute("""
    CREATE TABLE IF NOT EXISTS patients (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT,
        age TEXT,
        gender TEXT,
        blood_group TEXT,
        address TEXT,
        phone TEXT,
        symptoms TEXT,
        disease TEXT
        )
        """)

    # Helps in inserting data
    
    cursor.execute(
        """
        INSERT INTO patients 
        (name, age, gender, blood_group, address, phone, symptoms, disease)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)""", 
        (
        ename.get(),
        eage.get(),
        egen.get(),
        ebg.get(),
        eadd.get(),
        eph.get(),
        ", ".join(symptoms),   # convert list to string
        best_match
    ))

    connec.commit() # Save the changes 
    connec.close() 

btn = tk.Button(window,text="Diagnose",command=diagnose)
btn.pack(pady=20)

window.mainloop() #keeps running

#Display a message with beep of successful data insertion in database file(health.db) of patients

messagebox.showinfo("Success", "Data saved successfully!")

## For printing the database file
con = sq.connect("Health.db")
cur = con.cursor()

cur.execute("SELECT * FROM patients")
rows = cur.fetchall()

for row in rows:
    print(row)

con.close()


